# Copy to .env.local; load in your trusted shell before launching.
# Hy-Nomas video generation still requires its native NVIDIA GPU checkpoints.
# Choose ONE provider and set its model. Do not commit credentials.

# Local Ollama (no key required):
PE_PROVIDER=ollama-local
PE_API_URL=http://127.0.0.1:11434/v1
PE_MODEL=qwen2.5vl:7b

# Direct Ollama Cloud:
# PE_PROVIDER=ollama-cloud
# PE_MODEL=gemma4:31b
# OLLAMA_API_KEY=replace-with-key

# Amazon Bedrock (use an AWS profile, role, or other default credential source):
# PE_PROVIDER=bedrock
# PE_MODEL=your-enabled-bedrock-model-id
# AWS_REGION=eu-west-1

# Original Nomas-PE on SGLang:
# PE_PROVIDER=sglang
# PE_API_URL=http://127.0.0.1:30000/v1
# PE_MODEL=Nomas-PE

PE_API_TIMEOUT=300
PE_API_RETRIES=3
NOMAS_GATEWAY_HOST=127.0.0.1
